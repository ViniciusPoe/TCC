# Copie para backend/.env e preencha. NUNCA commite o .env.
# Gere chaves com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Banco: use SQLALCHEMY_DATABASE_URI (produção) OU as variáveis DB_* abaixo.
# SQLALCHEMY_DATABASE_URI=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=doacao_sangue

# Desenvolvimento local apenas. Em produção deixe False ou remova.
FLASK_DEBUG=False
# JWT_EXPIRES_HOURS=8
# CORS_ORIGINS=http://localhost:3000,https://seu-frontend.onrender.com
